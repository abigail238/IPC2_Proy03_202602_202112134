@page
@model IPC2_Proy03.Frontend.Pages.InicializarModel

@{
    ViewData["Title"] = "Inicializar sistema";
}

<div class="container mt-4">

    <h2>Inicializar sistema</h2>

    <div class="alert alert-warning mt-3">

        <strong>Advertencia:</strong>

        Esta operación eliminará los datos actuales
        del RTU y las autorizaciones procesadas.

    </div>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Inicializar sistema

        </button>

    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Resultado))
    {
        <div class="alert alert-success mt-4">

            Sistema inicializado correctamente.

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger mt-4">

            @Model.Error

        </div>
    }

</div>