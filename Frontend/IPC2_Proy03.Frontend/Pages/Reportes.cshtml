@page
@model IPC2_Proy03.Frontend.Pages.ReportesModel

@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-4">

    <h2>Reporte de facturas</h2>

    <p class="text-muted">
        Seleccione un rango de fechas para consultar
        las facturas procesadas y los errores encontrados.
    </p>

    <form method="post">

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Fecha inicial
                </label>

                <input asp-for="FechaInicio"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Fecha final
                </label>

                <input asp-for="FechaFin"
                       type="date"
                       class="form-control" />

            </div>

        </div>

        <button type="submit" class="btn btn-primary">Consultar</button>

        <button  type="submit"
        asp-page-handler="Pdf"
        class="btn btn-danger">

    Generar PDF

        </button>

    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger mt-4">
            @Model.Error
        </div>
    }

    @if (Model.Resultado.Count > 0)
    {
        <hr />

        <h4>Resultados</h4>

        @foreach (var item in Model.Resultado)
        {
            <div class="card mb-4">

                <div class="card-header">
                    <strong>
                        Fecha:
                        @item.Fecha.ToString("dd/MM/yyyy")
                    </strong>
                </div>

                <div class="card-body">

                    <p>
                        <strong>
                            Cantidad total de facturas recibidas:
                        </strong>

                        @item.CantidadTotalFacturasRecibidas
                    </p>

                    <p>
                        <strong>
                            Cantidad de facturas sin errores:
                        </strong>

                        @item.CantidadFacturasSinErrores
                    </p>

                    <p>
                        <strong>
                            Cantidad de emisores:
                        </strong>

                        @item.CantidadEmisores
                    </p>

                    <p>
                        <strong>
                            Cantidad de receptores:
                        </strong>

                        @item.CantidadReceptores
                    </p>


                    <h5 class="mt-4">
                        Errores
                    </h5>

                    <table class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Tipo de error</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>NIT emisor inválido</td>
                                <td>@item.NitEmisorInvalido</td>
                            </tr>

                            <tr>
                                <td>NIT receptor inválido</td>
                                <td>@item.NitReceptorInvalido</td>
                            </tr>

                            <tr>
                                <td>NIT emisor inexistente</td>
                                <td>@item.NitEmisorInexistente</td>
                            </tr>

                            <tr>
                                <td>NIT receptor inexistente</td>
                                <td>@item.NitReceptorInexistente</td>
                            </tr>

                            <tr>
                                <td>IVA mal calculado</td>
                                <td>@item.IvaMalCalculado</td>
                            </tr>

                            <tr>
                                <td>TOTAL mal calculado</td>
                                <td>@item.TotalMalCalculado</td>
                            </tr>

                            <tr>
                                <td>REFERENCIA duplicada</td>
                                <td>@item.ReferenciaDuplicada</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }

</div>
