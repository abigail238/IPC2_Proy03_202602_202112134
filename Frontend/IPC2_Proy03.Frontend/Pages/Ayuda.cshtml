@page
@model IPC2_Proy03.Frontend.Pages.AyudaModel

@{
    ViewData["Title"] = "Ayuda";
}

<div class="container mt-4">

    <h2>Ayuda</h2>

    <nav class="nav mb-3" aria-label="Opciones de ayuda">
        <a class="nav-link" href="#estudiante">Información del estudiante</a>
        <a class="nav-link" href="#documentacion">Documentación del programa</a>
    </nav>

    <div class="card mt-4" id="estudiante">

        <div class="card-header">
            Información del estudiante
        </div>

        <div class="card-body">

            <p>
                <strong>Nombre:</strong>
                @Model.NombreEstudiante
            </p>

            <p>
                <strong>Carné:</strong>
                @Model.Carnet
            </p>

            <p>
                <strong>Curso:</strong>
                @Model.Curso
            </p>

            <p>
                <strong>Proyecto:</strong>
                @Model.Proyecto
            </p>

        </div>

    </div>


    <div class="card mt-4">

        <div class="card-header">
            Funcionamiento del sistema
        </div>

        <div class="card-body">

            <p>
                El sistema permite enviar archivos JSON
                para actualizar el RTU y solicitar
                autorizaciones de documentos tributarios.
            </p>

            <p>
                También permite consultar facturas,
                visualizar resúmenes de IVA,
                obtener estadísticas por rango de fechas
                e inicializar los datos almacenados.
            </p>

        </div>

    </div>

    <section class="card mt-4" id="documentacion" aria-labelledby="tituloDocumentacion">
        <div class="card-header" id="tituloDocumentacion">Documentación del programa</div>
        <div class="card-body">
            <p>Consulta el ensayo y los diagramas del proyecto.</p>
            <a class="btn btn-primary" asp-page="/Ayuda" asp-page-handler="Documento"
               asp-route-archivo="Ensayo-IPC2-Py03.docx.pdf" target="_blank" rel="noopener">
                Abrir ensayo PDF
            </a>
            <h3 class="h5 mt-4">Diagramas</h3>
            <div class="row">
                @foreach (var documento in AyudaModel.Documentos.Where(d => d.Key.EndsWith(".png")))
                {
                    <div class="col-md-6 mb-4">
                        <figure>
                            <a asp-page="/Ayuda" asp-page-handler="Documento" asp-route-archivo="@documento.Key"
                               target="_blank" rel="noopener">
                                <img src="@Url.Page("/Ayuda", "Documento", new { archivo = documento.Key })"
                                     alt="@documento.Value" class="img-fluid border rounded" loading="lazy" />
                            </a>
                            <figcaption class="mt-2">@documento.Value</figcaption>
                        </figure>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
