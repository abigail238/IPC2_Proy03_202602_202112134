<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Proyecto 3</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="nav flex-wrap border-bottom pb-3 mb-4" aria-label="Menú principal">
            <a class="nav-link" asp-page="/Index">Inicio</a>
            <a class="nav-link" asp-page="/EnviarMensaje">Enviar mensaje</a>
            <a class="nav-link" asp-page="/ConsultarContribuyente">Consultar contribuyente</a>
            <a class="nav-link" asp-page="/ResumenIva">Resumen IVA</a>
            <a class="nav-link" asp-page="/ResumenRango">Resumen por rango</a>
            <a class="nav-link" asp-page="/Reportes">Reportes</a>
            <a class="nav-link" asp-page="/Inicializar">Inicializar</a>
            <a class="nav-link" asp-page="/Ayuda">Ayuda</a>
        </nav>
    </header>
    <main>
        <div asp-validation-summary="All" class="text-danger"></div>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
